{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "generated_at",
    "inputs",
    "analysis"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "news",
        "market"
      ],
      "properties": {
        "news": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headline_count",
            "summary",
            "detailed_summary",
            "top_headlines",
            "notable_sources",
            "macro_themes",
            "sector_notes"
          ],
          "properties": {
            "headline_count": {
              "type": "integer",
              "minimum": 0
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "detailed_summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 450
            },
            "top_headlines": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "notable_sources": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "macro_themes": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "sector_notes": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sector",
                  "tone",
                  "drivers"
                ],
                "properties": {
                  "sector": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  "tone": {
                    "type": "string",
                    "enum": [
                      "positive",
                      "neutral",
                      "negative"
                    ]
                  },
                  "drivers": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 30
                    }
                  }
                }
              }
            }
          }
        },
        "market": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability"
          ],
          "properties": {
            "availability": {
              "type": "string",
              "enum": [
                "available",
                "unavailable"
              ]
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "market_bias",
        "confidence",
        "macro_drivers",
        "risks",
        "watch_items"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "market_bias": {
          "type": "string",
          "enum": [
            "bullish",
            "neutral",
            "bearish"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "macro_drivers": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "risks": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "watch_items": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    }
  }
}
